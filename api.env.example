GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
PORT=5000
FRONTEND_URL=http://localhost:5000


GEMINI_API_KEY=optional_google_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GMAIL_FETCH_LIMIT=50
GMAIL_QUERY=newer_than:30d

# Optional active-context working memory. Apply the Supabase migrations first.
# The secret key is server-only and must never be exposed by an API or frontend.
SUPABASE_CONTEXT_ENABLED=0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
MAILMATE_USER_NAMESPACE_UUID=replace_with_a_random_uuid_v4
# On Windows, MailMate generates a DPAPI-protected local key automatically.
# On other platforms, set this to URL-safe base64 for exactly 32 random bytes.
MAILMATE_DATA_ENCRYPTION_KEY=
# Optional account recovery. Uses backend Application Default Credentials,
# never the user's Gmail OAuth token or authenticator code.
GOOGLE_CLOUD_KMS_KEY_NAME=projects/your-project/locations/global/keyRings/mailmate/cryptoKeys/account-recovery
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_NAME=George
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=

# Mailmate private LAN / hotspot compute
LM_STUDIO_BASE_URL=http://127.0.0.1:2806/v1
LM_STUDIO_MODEL=qwen/qwen3.5-4b

# Host workstation:
MAILMATE_WORKER_HOST=0.0.0.0
MAILMATE_WORKER_PORT=2810
MAILMATE_WORKER_TOKEN=replace_with_shared_random_secret

# Teammate laptop:
# Replace the address with the hotspot host IPv4 shown by ipconfig.
MAILMATE_REMOTE_WORKER_URL=http://192.168.137.1:2810
MAILMATE_COMPUTE_LABEL=Priyam's hotspot
# Optional local speech-to-text tuning. Defaults are adaptive:
# CUDA -> small/float16; CPU-only -> base.en/int8 with up to 4 threads.
WHISPER_GPU_MODEL=small
WHISPER_CPU_MODEL=base.en
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=en
